text \<open>The changed method stops on the octagon within 14 corrections for every focus angle and
  every tie rule, and at the stop the true pattern is below -20 dB off the main lobe.\<close>

theorem goctagon_stops_no_band:
  "tie_rule tm ts \<Longrightarrow> gstops_within ocp 9 (real_of_float oc_dlf) None tm ts t 14"
  by (rule goc_pieces_terminates [OF band_none gall_nc])

theorem goctagon_sidelobes_no_band:
  "tie_rule tm ts \<Longrightarrow> \<exists>n \<le> 14. gelig ocp 9 (real_of_float oc_dlf) None tm (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) t = {} \<and>
     (\<forall>\<phi>. pw ocp 9 (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) \<phi> > sqmax ocp 9 (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) / 100 \<longrightarrow>
        (\<exists>q y. lift q y \<and> (q = tm (fmains ocp 9 (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) t) mod M \<or> (q < M \<and> \<not> in_band None t q))
           \<and> (\<forall>\<theta>. min \<phi> y \<le> \<theta> \<and> \<theta> \<le> max \<phi> y \<longrightarrow>
                pw ocp 9 (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) \<theta>
                  > sqmax ocp 9 (grun ocp 9 (real_of_float oc_dlf) None tm ts t n) / 100 - 2 * real_of_float oc_dlf)))"
  by (rule goc_guarantee [OF goctagon_stops_no_band])

